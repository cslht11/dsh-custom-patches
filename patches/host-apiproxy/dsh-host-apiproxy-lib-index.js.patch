+			/**
+			* Rewrite the LAST user message of a session and regenerate from it,
+			* Codex-style: the new text replaces the previous user message AND all
+			* assistant/tool surface nodes that followed it (they are shadowed by a
+			* surface replace, never deleted from the append-only log), then the
+			* agent is woken to answer the edited prompt anew. Only the most recent
+			* user message is editable; everything before it stays read-only.
+			* @param request - `session.editLastPrompt` request.
+			* @returns accepted, or a business error (agent busy / nothing to edit /
+			*   empty text / rewrite rejected).
+			*/
+			async editLastPrompt(request) {
+				const { sessionId, text } = request.payload;
+				const resolved = await turnAgentFor(request, sessionId);
+				if ("refused" in resolved) return resolved.refused;
+				const agent = resolved.agent;
+				if (agent.status !== "idle") return err(request, {
+					code: "agent-busy",
+					message: "editing is unavailable while the agent is working",
+					details: {}
+				});
+				if (text.trim() === "") return err(request, {
+					code: "invalid-content",
+					message: "the edited prompt must contain text",
+					details: {}
+				});
+				const { session } = agent;
+				const nodes = session.surface.nodes;
+				let lastUserIndex = -1;
+				for (let i = nodes.length - 1; i >= 0; i--) {
+					const event = session.events[nodes[i]];
+					if (event?.type === "user/message" && event.data.source?.kind === "user") {
+						lastUserIndex = i;
+						break;
+					}
+				}
+				if (lastUserIndex === -1) return err(request, {
+					code: "nothing-to-edit",
+					message: "this session has no user message to edit",
+					details: {}
+				});
+				const startSeq = nodes[lastUserIndex];
+				const endSeq = nodes[nodes.length - 1];
+				const sourceEventSeqs = nodes.slice(lastUserIndex);
+				const message = createUserMessage({
+					content: [{
+						type: "text",
+						text
+					}],
+					source: {
+						kind: "user",
+						rpcId: request.rpcId
+					}
+				});
+				try {
+					session.append("user/message", message, {
+						surfaceOp: {
+							op: "replace",
+							start: startSeq,
+							end: endSeq
+						},
+						sourceEventSeqs
+					});
+				} catch (error) {
+					return err(request, {
+						code: "edit-rejected",
+						message: `unable to rewrite the last message: ${String(error)}`,
+						details: {}
+					});
+				}
+				agent.followup(message);
+				return ok(request, {
+					accepted: true
+				});
